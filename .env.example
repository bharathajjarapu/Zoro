# Copy to .env. Environment variables win over this file, so a secret can stay
# out of it entirely. This file is gitignored; .env.example is not.

# --- required ---
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4.1-mini

# --- required for the Telegram daemon; `zoro chat` and `zoro run` do not need them ---
CHAT_ID=0
OWNER_ID=0
TELEGRAM_TOKEN=123456:replace-me

# --- optional ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_VISION_MODEL=gpt-4.1-mini
# ZORO_DATA_DIR=data
# ZORO_SKILLS_DIR=skills
# ZORO_WORKSPACE=workspace
