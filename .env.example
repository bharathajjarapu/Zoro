# Copy to .env; environment variables override it.

# --- required ---
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4.1-mini

# --- required for web tools ---
TINYFISH_API_KEY=tf-replace-me

# --- required for the Telegram daemon; `zoro chat` and `zoro run` do not need them ---
TELEGRAM_TOKEN=123456:replace-me
OWNER_ID=0
CHAT_ID=0

# --- optional ---
# LLM_BASE_URL=https://api.openai.com/v1
# ZORO_HOME=/var/lib/zoro
# ZORO_ENV_FILE=/var/lib/zoro/.env
# ZORO_DATA_DIR=/var/lib/zoro/data
# ZORO_SKILLS_DIR=/var/lib/zoro/skills
# ZORO_WORKSPACE=/var/lib/zoro/workspace
# ZORO_INBOX_DIR=/var/lib/zoro/workspace/inbox
# ZORO_TMP_DIR=/var/lib/zoro/tmp
# ZORO_SHELL=ask
